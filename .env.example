# Temple — Dana explorer (https://danaverse.org)
#
# Public Chronik mirrors (comma-separated). Browser calls these directly.
# VITE_CHRONIK_URLS=https://chronik.e.cash,https://xec.paybutton.org,https://chronik.pay2stay.com/xec
#
# W Lotus DANA index (CORS is open). Used for recent / search / star groups.
# Leave empty to use the production index.
# VITE_DANA_INDEX_BASE=https://wlotus.org/index-api
#
# onest.pet PAW index (same DANA wire, pet memorials). Merged into the same
# ledger list. Leave empty to use the production index.
# VITE_PAW_INDEX_BASE=https://onest.pet/index-api
#
# Where “Offer a lotus” links go.
# VITE_OFFER_ORIGIN=https://wlotus.org
#
# Where onest.pet (PAW) memorials link out to.
# VITE_ONEST_ORIGIN=https://onest.pet
#
# Canonical site origin for share / OG later.
# VITE_PUBLIC_SITE_ORIGIN=https://danaverse.org
